<?xml version="1.0"?>
<package format="3">
  <name>yolo26_trt</name>
  <version>1.0.0</version>
  <description>Open-source YOLO26 TensorRT 10 deploy: CUDA letterbox, end-to-end [1,max_det,6] detect, ROS 2 image node and OpenCV demo.</description>
  <maintainer email="yanqifa9@gmail.com">yanqifa</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
